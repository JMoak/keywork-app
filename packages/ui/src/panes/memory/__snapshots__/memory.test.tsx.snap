exports[`the garden lens > renders the recorded garden: layers with their ramp, notes, the inbox by kind, the gardener 1`] = `"<div class="kw-memory" tabindex="-1" data-lens="garden"><div class="kw-memory-garden"><p class="kw-memory-gardener">gardener idle</p><section class="kw-memory-section" data-section="layer:workspace"><h3 class="kw-memory-heading">workspace</h3><ol class="kw-memory-rows"><li class="kw-memory-item" data-kind="layer" data-row="layer:workspace" data-cursor=""><button type="button" class="kw-memory-row"><span class="kw-gauge" role="img" aria-label="curing · 2 settled" title="curing · 2 settled"><span class="kw-gauge-cells" aria-hidden="true"><span class="kw-gauge-cell" data-level="full">█</span><span class="kw-gauge-cell" data-level="full">█</span><span class="kw-gauge-cell" data-level="full">█</span><span class="kw-gauge-cell" data-level="full">█</span><span class="kw-gauge-cell" data-level="full">█</span><span class="kw-gauge-cell" data-level="full">█</span><span class="kw-gauge-cell" data-level="full">█</span><span class="kw-gauge-cell" data-level="full">█</span></span></span><span class="kw-memory-title">2 notes</span><span class="kw-memory-facts"><span class="kw-gauge" role="img" aria-label="prompt 0 of 4096 tokens" title="prompt 0 of 4096 tokens"><span class="kw-gauge-cells" aria-hidden="true"><span class="kw-gauge-cell" data-level="empty">·</span><span class="kw-gauge-cell" data-level="empty">·</span><span class="kw-gauge-cell" data-level="empty">·</span><span class="kw-gauge-cell" data-level="empty">·</span><span class="kw-gauge-cell" data-level="empty">·</span><span class="kw-gauge-cell" data-level="empty">·</span><span class="kw-gauge-cell" data-level="empty">·</span><span class="kw-gauge-cell" data-level="empty">·</span></span></span><span class="kw-memory-fact">prompt 0 of 4096 tokens</span></span></button></li><li class="kw-memory-item" data-kind="note" data-row="note:workspace:Layout Rects"><button type="button" class="kw-memory-row"><span class="kw-memory-marks"><span class="kw-memory-mark kw-gauge-cell" data-level="full" title="settled">█</span><span class="kw-memory-mark kw-gauge-cell" data-level="full" title="user">█</span></span><span class="kw-memory-title">Layout Rects</span><span class="kw-memory-facts"><span class="kw-memory-fact">pinned</span><span class="kw-memory-fact">in prompt</span><span class="kw-memory-fact">2 recalls</span></span></button></li><li class="kw-memory-item" data-kind="note" data-row="note:workspace:Composer Enter"><button type="button" class="kw-memory-row"><span class="kw-memory-marks"><span class="kw-memory-mark kw-gauge-cell" data-level="full" title="settled">█</span><span class="kw-memory-mark kw-gauge-cell" data-level="full" title="user">█</span></span><span class="kw-memory-title">Composer Enter</span><span class="kw-memory-facts"><span class="kw-memory-fact">pinned</span><span class="kw-memory-fact">in prompt</span><span class="kw-memory-fact">2 recalls</span></span></button></li></ol></section><section class="kw-memory-section" data-section="daily"><h3 class="kw-memory-heading">daily</h3><ol class="kw-memory-rows"><li class="kw-memory-item" data-kind="date" data-row="date:2026-09-07"><button type="button" class="kw-memory-row"><span class="kw-memory-title">2026-09-07</span></button></li></ol></section><section class="kw-memory-section" data-section="inbox:staged"><h3 class="kw-memory-heading">inbox · staged</h3><ol class="kw-memory-rows"><li class="kw-memory-item" data-kind="inbox" data-row="inbox:q1"><button type="button" class="kw-memory-row"><span class="kw-memory-marks"><span class="kw-memory-mark kw-gauge-cell" data-level="light" title="untrusted">░</span></span><span class="kw-memory-title">Stray Claim.md</span><span class="kw-memory-facts"><span class="kw-memory-fact">note</span><span class="kw-memory-fact">33d</span></span></button></li><li class="kw-memory-item" data-kind="inbox" data-row="inbox:q2"><button type="button" class="kw-memory-row"><span class="kw-memory-marks"><span class="kw-memory-mark kw-gauge-cell" data-level="light" title="untrusted">░</span></span><span class="kw-memory-title">Tray Mark.md</span><span class="kw-memory-facts"><span class="kw-memory-fact">note</span><span class="kw-memory-fact">33d</span></span></button></li></ol></section></div></div>"`;

exports[`the ledger lens > lists entries newest first and reports a needs-rebase revert honestly 1`] = `"<div class="kw-memory" tabindex="-1" data-lens="ledger"><ol class="kw-memory-rows"><li class="kw-memory-item" data-kind="ledger" data-row="q6" data-cursor=""><button type="button" class="kw-memory-row"><span class="kw-memory-marks"><span class="kw-memory-mark kw-gauge-cell" data-level="light" title="revert">░</span></span><span class="kw-memory-title">revert Stray Claim</span><span class="kw-memory-facts"><span class="kw-memory-fact">2026-09-07T12:00:00.000Z</span><span class="kw-memory-fact">3 files</span><span class="kw-memory-fact" data-outcome="needs-rebase">needs rebase · the file moved on, nothing touched</span></span></button></li><li class="kw-memory-item" data-kind="ledger" data-row="q4"><button type="button" class="kw-memory-row"><span class="kw-memory-marks"><span class="kw-memory-mark kw-gauge-cell" data-level="heavy" title="discard">▓</span></span><span class="kw-memory-title">discard .staging/q5.md</span><span class="kw-memory-facts"><span class="kw-memory-fact">2026-09-07T12:00:00.000Z</span><span class="kw-memory-fact">2 files</span></span></button></li><li class="kw-memory-item" data-kind="ledger" data-row="q3"><button type="button" class="kw-memory-row"><span class="kw-memory-marks"><span class="kw-memory-mark kw-gauge-cell" data-level="heavy" title="approve">▓</span></span><span class="kw-memory-title">approve Stray Claim</span><span class="kw-memory-facts"><span class="kw-memory-fact">2026-09-07T12:00:00.000Z</span><span class="kw-memory-fact">3 files</span></span></button></li></ol><p class="kw-memory-notice">needs rebase · the file moved on, nothing touched</p></div>"`;

exports[`the note lens > opens the focused note with its facts, prose body and relations, and backs out 1`] = `"<article class="kw-memory-note"><h2 class="kw-memory-note-title">Layout Rects</h2><p class="kw-memory-note-facts"><span class="kw-memory-fact">workspace</span><span class="kw-memory-fact">user</span><span class="kw-memory-fact">settled</span><span class="kw-memory-fact">pinned</span><span class="kw-memory-fact">in prompt</span><span class="kw-memory-fact">2 recalls</span><span class="kw-memory-fact">12 tokens</span></p><div class="kw-prose kw-memory-note-body"><p class="kw-paragraph">Rects are the <strong>single</strong> geometric truth.</p></div><h3 class="kw-memory-heading">relations</h3><ul class="kw-memory-relations"><li class="kw-memory-relation">→ relates to<!----> Composer Enter</li></ul></article>"`;
