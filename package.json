{
  "name": "keywork-app-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/desktop dev",
    "dist": "bun run --cwd packages/desktop dist",
    "setup:electron": "node packages/desktop/node_modules/electron/install.js",
    "check": "bun run check:types && bun run check:clean-src && bun run check:test-imports && bun run check:pins && bun run check:guardrails && bun run check:copy && bun run check:colors && bun run check:contract && bun run check:themes && bun run check:textures && bun run lint",
    "check:types": "tsc --build",
    "check:clean-src": "bun scripts/check-clean-src.ts",
    "check:test-imports": "bun scripts/check-test-imports.ts",
    "check:pins": "bun scripts/check-pins.ts",
    "check:guardrails": "bun scripts/check-guardrails.ts",
    "check:copy": "bun scripts/check-copy.ts",
    "check:colors": "bun scripts/check-colors.ts",
    "check:contract": "bun scripts/check-contract.ts",
    "check:textures": "bun scripts/check-textures.ts",
    "check:themes": "bun scripts/sync-themes.ts --check",
    "sync:themes": "bun scripts/sync-themes.ts",
    "fixtures:record": "bun scripts/fixtures/record.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "fetch:sidecar": "bun scripts/fetch-sidecar.ts",
    "pack:sdk": "bun run check:types && bun run --cwd packages/desktop build && bun scripts/pack-sdk.ts",
    "screenshots": "bun run --cwd packages/ui screenshots",
    "compare:shots": "bun scripts/compare-shots.ts",
    "perf:screen": "bun scripts/textures/perf-screen.ts",
    "smoke:first-light": "node packages/desktop/e2e/first-light/smoke.mjs"
  },
  "trustedDependencies": [
    "electron",
    "node-pty"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@keywork-app/client": "workspace:*",
    "@keywork-app/protocol": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "24.10.1",
    "happy-dom": "20.14.0",
    "solid-js": "1.9.15",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.10",
    "@semantic-release/commit-analyzer": "13.0.1",
    "conventional-changelog-conventionalcommits": "8.0.0",
    "semver": "7.8.6",
    "@types/semver": "7.8.0"
  }
}
